# --- Backend dependency injection (see docker/docker-compose.yml) ---
# Option A: docker compose -f docker/docker-compose.yml up -d llamaswap
# Option B: use an existing OpenAI/Anthropic-compatible endpoint
HB_BACKEND_URL=http://127.0.0.1:8080
# URL the *eval containers* use to reach the backend (host.docker.internal
# when the backend runs on the host or in a sibling container)
HB_CONTAINER_BACKEND_URL=http://host.docker.internal:8080
HB_MODEL=strata_iq3s
# Root for out/, work/ and repos/ (leave empty for the repo root). The read-only
# runtime mounted into eval containers as /opt/hb comes from HB_RUNTIME_DIR.
HB_HOME=
# Portable harness runtime built by scripts/setup_hb.sh — absolute host path
# (the bench service needs it; it is passed straight to the Docker daemon)
HB_RUNTIME_DIR=
# GGUF/model dir mounted read-only into the llamaswap container
HB_MODEL_DIR=./models
