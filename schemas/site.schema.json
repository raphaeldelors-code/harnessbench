{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "site.json aggregation",
  "description": "Built by site/build.py from runs/*/: harness lane under `runs`, model bench lane under `model_runs` plus one aggregated entry per served model under `models`.",
  "type": "object",
  "required": ["generated", "hardware", "runs", "model_runs", "models"],
  "properties": {
    "generated": {"type": "string"},
    "hardware": {"type": "object"},
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "date", "model", "n_instances", "instances", "harnesses", "mcnemar"],
        "properties": {
          "id": {"type": "string"},
          "n_instances": {"type": "integer", "minimum": 1},
          "harnesses": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "required": ["resolved"],
              "properties": {"resolved": {"type": "integer", "minimum": 0}}
            }
          },
          "windows": {"type": "object"},
          "mcnemar": {"type": "object", "minProperties": 1}
        }
      }
    },
    "model_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "date", "title", "model", "engine", "verdict", "hardware", "legs", "rows", "cells"],
        "properties": {
          "id": {"type": "string", "pattern": "^m-[0-9]{4}-[0-9]{2}-[0-9]{2}-.+"},
          "kind": {"const": "model"},
          "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "title": {"type": "string", "minLength": 1},
          "model": {
            "type": "object",
            "required": ["slug", "quant", "family"],
            "properties": {
              "slug": {"type": "string", "minLength": 1},
              "quant": {"type": "string", "minLength": 1},
              "family": {"type": "string", "minLength": 1}
            }
          },
          "engine": {"type": "string", "minLength": 1},
          "verdict": {"enum": ["INFO", "KEEP", "CONFIRM-KEEP", "REVERT", "UNDO", "PASS", "PARTIAL"]},
          "hardware": {"type": "string", "pattern": "^bench-rig-[0-9]+$"},
          "notes": {"type": "string"},
          "agentic": {
            "type": "object",
            "description": "Passed through from run.json (schemas/modelrun.schema.json) for agentic showdown rounds; absent on tuning rounds. The Models lane renders these in their own showdown section instead of the tuning-leg charts.",
            "required": ["n_instances", "resolved", "unresolved", "empty", "per_instance"],
            "additionalProperties": false,
            "properties": {
              "steps_cap": {"type": ["integer", "null"], "minimum": 1},
              "temperature": {"type": ["number", "null"], "minimum": 0},
              "n_instances": {"type": "integer", "minimum": 1},
              "resolved": {"type": "integer", "minimum": 0},
              "unresolved": {"type": "integer", "minimum": 0},
              "empty": {"type": "integer", "minimum": 0},
              "partial_credit": {"type": ["number", "null"], "minimum": 0},
              "gpu_hours": {"type": ["number", "null"], "minimum": 0},
              "resolved_per_gpu_h": {"type": ["number", "null"], "minimum": 0},
              "perf": {
                "type": "object",
                "description": "Agent-phase performance of the round, passed through verbatim from run.json (see schemas/modelrun.schema.json for what each field means and when it is null); build.py computes nothing here.",
                "additionalProperties": false,
                "properties": {
                  "requests": {"type": ["integer", "null"], "minimum": 0},
                  "in_tokens": {"type": ["integer", "null"], "minimum": 0},
                  "out_tokens": {"type": ["integer", "null"], "minimum": 0},
                  "encode_avg": {"type": ["number", "null"], "minimum": 0},
                  "encode_med": {"type": ["number", "null"], "minimum": 0},
                  "decode_avg": {"type": ["number", "null"], "minimum": 0},
                  "decode_med": {"type": ["number", "null"], "minimum": 0},
                  "cache_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
                  "mtp_acc_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
                  "max_out": {"type": ["integer", "null"], "minimum": 0},
                  "n_out_gt4096": {"type": ["integer", "null"], "minimum": 0},
                  "n_out_gt8192": {"type": ["integer", "null"], "minimum": 0},
                  "errors": {"type": ["integer", "null"], "minimum": 0},
                  "phase_wall_s": {"type": ["number", "null"], "minimum": 0},
                  "cap_tokens": {"type": ["integer", "null"], "minimum": 1},
                  "vram_gib": {"type": ["number", "null"], "minimum": 0}
                }
              },
              "per_instance": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["instance", "result"],
                  "additionalProperties": false,
                  "properties": {
                    "instance": {"type": "string", "minLength": 1},
                    "result": {"enum": ["resolved", "unresolved", "empty"]},
                    "steps": {"type": ["integer", "null"], "minimum": 0},
                    "credit": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
                    "patch": {"type": ["boolean", "null"]}
                  }
                }
              }
            }
          },
          "n_rows": {"type": "integer", "minimum": 1},
          "n_warm": {"type": "integer", "minimum": 0},
          "legs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "rows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["leg", "tag", "pp", "tps"],
              "properties": {
                "leg": {"type": "string", "minLength": 1},
                "tag": {"type": "string", "minLength": 1},
                "in_tok": {"type": ["integer", "null"], "minimum": 0},
                "out_tok": {"type": ["integer", "null"], "minimum": 0},
                "pp": {"type": ["number", "null"], "exclusiveMinimum": 0},
                "tps": {"type": ["number", "null"], "exclusiveMinimum": 0},
                "draft": {"type": ["integer", "null"], "minimum": 0},
                "draft_acc": {"type": ["integer", "null"], "minimum": 0}
              }
            }
          },
          "cells": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["cell", "legs"],
              "properties": {
                "cell": {"type": "string", "minLength": 1},
                "in_tok": {"type": ["number", "null"]},
                "legs": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "object",
                    "required": ["n", "pp", "tps"],
                    "properties": {
                      "n": {"type": "integer", "minimum": 1},
                      "pp": {"type": ["number", "null"]},
                      "tps": {"type": ["number", "null"]}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "quant", "family", "engine", "n_runs", "tps", "pp", "verdicts"],
        "properties": {
          "slug": {"type": "string", "minLength": 1},
          "quant": {"type": "string"},
          "family": {"type": "string"},
          "engine": {"type": "string"},
          "n_runs": {"type": "integer", "minimum": 1, "description": "every round of this served model: tuning rounds plus showdown rounds"},
          "tps": {"type": ["number", "null"]},
          "pp": {"type": ["number", "null"]},
          "tps_range": {"type": ["array", "null"], "items": {"type": "number"}},
          "agentic_runs": {
            "type": "integer",
            "minimum": 0,
            "description": "how many of n_runs are agentic showdown rounds; n_runs - agentic_runs is the tuning-round count"
          },
          "best_resolved": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1,
            "description": "best showdown score of this model as a fraction of the instance set (max resolved / n_instances); null when the model never ran a showdown"
          },
          "verdicts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "date", "verdict", "tps", "pp", "n_rows", "legs"],
              "properties": {
                "id": {"type": "string", "pattern": "^m-"},
                "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
                "verdict": {"enum": ["INFO", "KEEP", "CONFIRM-KEEP", "REVERT", "UNDO", "PASS", "PARTIAL"]},
                "tps": {"type": ["number", "null"]},
                "pp": {"type": ["number", "null"]},
                "n_rows": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "speed rows in this round (warm-up and agent_phase legs excluded); 0 is a capture that holds only warm-up or only agent-phase rows, which is why its tps/pp are null"
                },
                "legs": {"type": "array", "items": {"type": "string"}},
                "agentic": {
                  "type": "boolean",
                  "description": "true when this round is an agentic showdown round (its outcome lives in the run's agentic block, not in the tuning-leg charts)"
                }
              }
            }
          }
        }
      }
    }
  }
}
